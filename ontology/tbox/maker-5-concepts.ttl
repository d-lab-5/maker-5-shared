@prefix m5:      <https://maker-5.cloud/ontology#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# ============================================================
# Concept schemes (SKOS), v0.1.
#
# New kinds are added HERE, as data: no code or schema change. Each concept
# needs an English prefLabel (the master); German and French are expected.
# ============================================================

m5:BlockTypes a skos:ConceptScheme ;
    skos:prefLabel "Kinds of blocks"@en , "Arten von Blöcken"@de , "Types de blocs"@fr ;
    skos:hasTopConcept m5:Electronic , m5:Mechanical .

m5:Electronic a skos:Concept ; skos:inScheme m5:BlockTypes ; skos:topConceptOf m5:BlockTypes ;
    skos:prefLabel "Electronic"@en , "Elektronik"@de , "Électronique"@fr .

m5:Mechanical a skos:Concept ; skos:inScheme m5:BlockTypes ; skos:topConceptOf m5:BlockTypes ;
    skos:prefLabel "Mechanical"@en , "Mechanik"@de , "Mécanique"@fr .

m5:ProposalStates a skos:ConceptScheme ;
    skos:prefLabel "States of a proposal"@en , "Status eines Vorschlags"@de , "États d'une proposition"@fr ;
    skos:hasTopConcept m5:Proposed , m5:Approved , m5:Rejected .

m5:Proposed a skos:Concept ; skos:inScheme m5:ProposalStates ; skos:topConceptOf m5:ProposalStates ;
    skos:prefLabel "Proposed"@en , "Vorgeschlagen"@de , "Proposée"@fr .

m5:Approved a skos:Concept ; skos:inScheme m5:ProposalStates ; skos:topConceptOf m5:ProposalStates ;
    skos:prefLabel "Approved"@en , "Genehmigt"@de , "Approuvée"@fr .

m5:Rejected a skos:Concept ; skos:inScheme m5:ProposalStates ; skos:topConceptOf m5:ProposalStates ;
    skos:prefLabel "Rejected"@en , "Abgelehnt"@de , "Rejetée"@fr .

m5:TrackingModes a skos:ConceptScheme ;
    skos:prefLabel "How an article is tracked"@en , "Wie ein Artikel erfasst wird"@de , "Comment un article est suivi"@fr ;
    skos:hasTopConcept m5:Bulk , m5:Serialised .

m5:Bulk a skos:Concept ; skos:inScheme m5:TrackingModes ; skos:topConceptOf m5:TrackingModes ;
    skos:prefLabel "In bulk"@en , "Als Menge"@de , "En vrac"@fr .

m5:Serialised a skos:Concept ; skos:inScheme m5:TrackingModes ; skos:topConceptOf m5:TrackingModes ;
    skos:prefLabel "Unit by unit"@en , "Einzeln"@de , "À l'unité"@fr .

m5:ArticleCategories a skos:ConceptScheme ;
    skos:prefLabel "Categories of articles"@en , "Artikelkategorien"@de , "Catégories d'articles"@fr ;
    rdfs:comment "Two levels (ADR-0019): a top category and its subcategories. skos:notation is the value an article carries, top or top/sub."@en ;
    skos:hasTopConcept m5:CategoryControllers , m5:CategorySensors , m5:CategoryActuators , m5:CategoryPower , m5:CategoryCommunication , m5:CategoryMedia , m5:CategoryComponents , m5:CategoryCables , m5:CategoryChassis , m5:CategoryMechanical , m5:CategoryTools , m5:CategoryConsumables , m5:CategoryOther .

m5:CategoryControllers a skos:Concept ; skos:inScheme m5:ArticleCategories ; skos:topConceptOf m5:ArticleCategories ;
    skos:notation "controllers" ;
    skos:prefLabel "Controllers & computers"@en , "Steuerungen & Rechner"@de , "Contrôleurs & ordinateurs"@fr ;
    skos:narrower m5:CategoryControllersSbc , m5:CategoryControllersMcu , m5:CategoryControllersRadioModules , m5:CategoryControllersStorage , m5:CategoryControllersPhones .

m5:CategoryControllersSbc a skos:Concept ; skos:inScheme m5:ArticleCategories ; skos:broader m5:CategoryControllers ;
    skos:notation "controllers/sbc" ;
    skos:prefLabel "Single-board computers"@en , "Einplatinenrechner"@de , "Ordinateurs monocarte"@fr .

m5:CategoryControllersMcu a skos:Concept ; skos:inScheme m5:ArticleCategories ; skos:broader m5:CategoryControllers ;
    skos:notation "controllers/mcu" ;
    skos:prefLabel "Microcontroller boards"@en , "Mikrocontroller-Boards"@de , "Cartes microcontrôleur"@fr .

m5:CategoryControllersRadioModules a skos:Concept ; skos:inScheme m5:ArticleCategories ; skos:broader m5:CategoryControllers ;
    skos:notation "controllers/radio-modules" ;
    skos:prefLabel "Radio modules"@en , "Funkmodule"@de , "Modules radio"@fr .

m5:CategoryControllersStorage a skos:Concept ; skos:inScheme m5:ArticleCategories ; skos:broader m5:CategoryControllers ;
    skos:notation "controllers/storage" ;
    skos:prefLabel "Storage"@en , "Speicher"@de , "Stockage"@fr .

m5:CategoryControllersPhones a skos:Concept ; skos:inScheme m5:ArticleCategories ; skos:broader m5:CategoryControllers ;
    skos:notation "controllers/phones" ;
    skos:prefLabel "Phones & tablets"@en , "Telefone & Tablets"@de , "Téléphones & tablettes"@fr .

